# ---- App ----
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ---- Google sign-in (OAuth client, type "Web application") ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Google data (Sheets + Drive) ----
# ID of the dedicated application spreadsheet created by scripts/sheets-setup.ts
GOOGLE_SHEETS_ID=
# Credentials - use ONE of these.
# Local: a path to the JSON key, kept outside the repo.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
# Serverless (Vercel, Lambda): the key itself, base64-encoded. There is no
# writable disk to put a file on. Generate with:
#   base64 -i secrets/service-account.json | tr -d '\n'
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional: shared Drive id (recommended) or specific folder ids. Leave blank to
# use the service account's own Drive folders created on demand.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_PHOTO_FOLDER_ID=
GOOGLE_DRIVE_DOC_FOLDER_ID=

# ---- Serialized write gateway (Google Apps Script Web App) ----
# Create from apps-script/Gateway.gs (Deploy > New deployment > Web app,
# execute as me, access: "anyone with Google account" is NOT needed - use
# "Anyone" only if your org blocks unauthenticated fetch from services).
GATEWAY_URL=
GATEWAY_TOKEN=
# Optional HMAC secret for signing gateway payloads (recommended over plain token)
GATEWAY_HMAC_SECRET=

# ---- Bootstrap owner (used ONLY to seed the Staff tab and sign in the first owner) ----
OWNER_EMAIL=

# ---- Demo mode (no Google account needed) ----
# DEMO_MODE=1 keeps all data in memory + .demo-data/ and enables staff pick-a-profile login.
DEMO_MODE=1
