# ---- App ----
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ---- Google data (Sheets + Drive) ----
# ID of the dedicated application spreadsheet created by scripts/sheets-setup.ts
GOOGLE_SHEETS_ID=
# Credentials - use ONE of these.
# Local: a path to the JSON key, kept outside the repo.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
# Serverless (Vercel, Lambda): the key itself, base64-encoded. There is no
# writable disk to put a file on. Generate with:
#   base64 -i secrets/service-account.json | tr -d '\n'
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional: Drive folders for photos/documents (stage 2 — not required to run
# the app; uploads are simply unavailable until these are set).
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_PHOTO_FOLDER_ID=
GOOGLE_DRIVE_DOC_FOLDER_ID=

# ---- Serialized write gateway (Google Apps Script Web App) — required ----
# Reservations, sales, payments and delivery all fail without this deployed.
# See docs/DEPLOYMENT.md. Both values below must match: GATEWAY_HMAC_SECRET
# here, and the Script Property named HMAC_SECRET on the deployed script.
GATEWAY_URL=
GATEWAY_HMAC_SECRET=

# ---- Demo mode (no Google account needed) ----
# DEMO_MODE=1 keeps all data in memory and enables staff pick-a-profile login.
# Never set this in a real deployment.
DEMO_MODE=1
