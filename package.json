{
  "name": "showroom-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/guard-build.mjs && next build",
    "start": "next start",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "staff:password": "tsx scripts/staff-password.ts",
    "sheets:check": "tsx scripts/sheets-check.ts",
    "sheets:setup": "tsx scripts/sheets-setup.ts",
    "sheets:validate": "tsx scripts/sheets-validate.ts",
    "sheets:seed": "tsx scripts/sheets-seed.ts",
    "sheets:audit": "tsx scripts/sheets-audit.ts",
    "sheets:reset": "tsx scripts/sheets-reset.ts",
    "schema:export": "tsx scripts/export-schema.ts",
    "e2e:server": "DEMO_MODE=1 NEXTAUTH_SECRET=cypress-test-secret-0123456789abcd NEXTAUTH_URL=http://localhost:3200 next dev -p 3200",
    "e2e:run": "env -u ELECTRON_RUN_AS_NODE -u ELECTRON_NO_ATTACH_CONSOLE cypress run",
    "e2e:open": "env -u ELECTRON_RUN_AS_NODE -u ELECTRON_NO_ATTACH_CONSOLE cypress open",
    "e2e": "start-server-and-test e2e:server http://localhost:3200/login e2e:run",
    "e2e:sheets:server": "DEMO_MODE=0 GOOGLE_SERVICE_ACCOUNT_FILE=\"\" NEXTAUTH_URL=http://localhost:3300 next dev -p 3300",
    "e2e:sheets:run": "env -u ELECTRON_RUN_AS_NODE -u ELECTRON_NO_ATTACH_CONSOLE cypress run --config-file cypress-sheets.config.ts",
    "e2e:sheets:snapshot": "tsx scripts/e2e-sheets/snapshot.ts",
    "e2e:sheets:verify": "tsx scripts/e2e-sheets/verify.ts",
    "e2e:sheets:cleanup": "tsx scripts/e2e-sheets/cleanup.ts",
    "field:audit": "tsx scripts/field-audit.ts",
    "gateway:deploy": "tsx scripts/deploy-gateway.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.0",
    "google-auth-library": "^9.15.1",
    "googleapis": "^144.0.0",
    "lucide-react": "^1.48.0",
    "next": "^15.5.2",
    "next-auth": "^4.24.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.62.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "cypress": "^13.17.0",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "postcss": "^8.5.0",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
